                    vexactpos 0
                    hexactsize 0
                    vexactsize 0
                    color 0.8 0.8 0.8 1
                    text "0.00"
                    font "gui/fonts/etelkatextpro22"
                    "exact text" 0
                    "text halign" center
                    "text valign" center
                }
                PanelWidgetClass SDN_RowDiv5 { ignorepointer 1; color 0.3 0.3 0.3 0.8; position 0.75 0; size 2 1; hexactpos 0; vexactpos 0; hexactsize 1; vexactsize 0; style DayZDefaultPanel; }
                
