PanelWidgetClass SDN_RowRoot
{
    ignorepointer 1
    color 0.1569 0.1569 0.1569 0.8
    position 0 0
    size 1 0.05
    halign center_ref
    valign top_ref
    hexactpos 0
    vexactpos 0
    hexactsize 0
    vexactsize 0
    style DayZDefaultPanel
    {
        PanelWidgetClass SDN_RowGrid 
        {
            ignorepointer 1
            position 0 0
            size 1 1
            halign center_ref
            valign center_ref
            hexactpos 0
            vexactpos 0
            hexactsize 0
            vexactsize 0
            {
                TextWidgetClass SDN_RankValue 
                {
                    ignorepointer 1
                    position 0 0
                    size 0.1 1
                    hexactpos 0
                    vexactpos 0
                    hexactsize 0
                    vexactsize 0
                    color 1 0.843 0 1
                    text "#"
                    font "gui/fonts/etelkatextpro22"
                    "exact text" 0
                    "text halign" center
                    "text valign" center
                }
                PanelWidgetClass SDN_RowDiv1 { ignorepointer 1; color 0.3 0.3 0.3 0.8; position 0.1 0; size 2 1; hexactpos 0; vexactpos 0; hexactsize 1; vexactsize 0; style DayZDefaultPanel; }
                
                TextWidgetClass SDN_PlayerName 
                {
                    ignorepointer 1
                    position 0.1 0
                    size 0.3 1
                    hexactpos 0
                    vexactpos 0
                    hexactsize 0
                    vexactsize 0
                    color 1 1 1 1
                    text "Name"
                    font "gui/fonts/etelkatextpro22"
                    "exact text" 0
                    "text halign" center
                    "text valign" center
                }
                PanelWidgetClass SDN_RowDiv2 { ignorepointer 1; color 0.3 0.3 0.3 0.8; position 0.4 0; size 2 1; hexactpos 0; vexactpos 0; hexactsize 1; vexactsize 0; style DayZDefaultPanel; }
                
                TextWidgetClass SDN_KillsValue 
                {
                    ignorepointer 1
                    position 0.4 0
                    size 0.1 1
                    hexactpos 0
                    vexactpos 0
                    hexactsize 0
                    vexactsize 0
                    color 0.196 0.804 0.196 1
                    text "0"
                    font "gui/fonts/etelkatextpro22"
                    "exact text" 0
                    "text halign" center
                    "text valign" center
                }
                PanelWidgetClass SDN_RowDiv3 { ignorepointer 1; color 0.3 0.3 0.3 0.8; position 0.5 0; size 2 1; hexactpos 0; vexactpos 0; hexactsize 1; vexactsize 0; style DayZDefaultPanel; }
                
                TextWidgetClass SDN_DeathsValue 
                {
                    ignorepointer 1
                    position 0.5 0
                    size 0.1 1
                    hexactpos 0
                    vexactpos 0
                    hexactsize 0
                    vexactsize 0
                    color 0.863 0.078 0.235 1
                    text "0"
                    font "gui/fonts/etelkatextpro22"
                    "exact text" 0
                    "text halign" center
                    "text valign" center
                }
                PanelWidgetClass SDN_RowDiv4 { ignorepointer 1; color 0.3 0.3 0.3 0.8; position 0.6 0; size 2 1; hexactpos 0; vexactpos 0; hexactsize 1; vexactsize 0; style DayZDefaultPanel; }
                
                TextWidgetClass SDN_KDValue 
                {
                    ignorepointer 1
                    position 0.6 0
                    size 0.15 1
